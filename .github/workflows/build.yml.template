name: Build

on:
  pull_request:
    branches:
    - main
  push:
    branches:
    - main
  workflow_dispatch:

jobs:
  build:
    name: Build
    runs-on: ubuntu-24.04
    # The R2 credentials are secrets of the production environment, which only
    # the main branch can use. PR builds run without an environment.
    environment: ${{ github.ref == 'refs/heads/main' && 'production' || '' }}
    steps:
    - uses: actions/checkout@v6
      with:
        fetch-depth: 2
    - uses: actions/setup-python@v6
      with:
        python-version: "3.14"@@build_with_node@@
    - run: pip install bikeshed && bikeshed update
    # Note: `make deploy` will do a deploy dry run on PRs.
    - run: make deploy
      env:
        SERVER: ${{ secrets.MARQUEE_SERVER }}
        SERVER_PUBLIC_KEY: ${{ secrets.MARQUEE_PUBLIC_KEY }}
        SERVER_DEPLOY_KEY: ${{ secrets.MARQUEE_DEPLOY_KEY }}
        AWS_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
        AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
        AWS_ENDPOINT_URL: ${{ secrets.R2_ENDPOINT }}
